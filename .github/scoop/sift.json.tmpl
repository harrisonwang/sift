{
  "version": "{{VERSION}}",
  "description": "Provider-driven technical news radar CLI",
  "homepage": "https://github.com/{{REPO}}",
  "license": "MIT",
  "architecture": {
    "64bit": {
      "url": "{{BASE_URL}}/{{TOOL}}_{{TAG}}_x86_64-pc-windows-msvc.zip",
      "hash": "{{SHA256:{{TOOL}}_{{TAG}}_x86_64-pc-windows-msvc.zip}}",
      "extract_dir": "sift"
    }
  },
  "bin": "sift.exe",
  "post_install": [
    "Write-Host '创建默认配置：sift config init'",
    "Write-Host '然后编辑 ~/.sift/config.yaml，并运行：sift config validate'"
  ],
  "checkver": {
    "github": "https://github.com/{{REPO}}"
  },
  "autoupdate": {
    "architecture": {
      "64bit": {
        "url": "https://github.com/{{REPO}}/releases/download/v$version/{{TOOL}}_v$version_x86_64-pc-windows-msvc.zip"
      }
    },
    "hash": {
      "url": "https://github.com/{{REPO}}/releases/download/v$version/SHA256SUMS.txt"
    }
  }
}
